# =============================================================================
# VIBECAST ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# These override settings in podcast/config.yaml

# =============================================================================
# API KEYS (Required)
# =============================================================================

# Anthropic API key (recommended - Claude Opus 4.8 writes the scripts)
# Get yours at: https://platform.claude.com/
# If unset, script writing falls back to the OpenAI model in config.yaml.
ANTHROPIC_API_KEY=

# OpenAI API key (required for TTS + artwork; also the writer fallback)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs API key (optional, only if using ElevenLabs TTS)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# =============================================================================
# CLOUDFLARE R2 STORAGE (Required)
# =============================================================================

# R2 Account ID (found in Cloudflare dashboard)
R2_ACCOUNT_ID=

# R2 API credentials (create at: Cloudflare → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# =============================================================================
# Bento messages you when a new episode posts (see notifications.* in
# podcast/config.yaml and TELEGRAM_NOTIFICATIONS.md).

# Bot token from @BotFather (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Chat to notify: DM your bot once, then grab the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (or message @userinfobot)
TELEGRAM_CHAT_ID=

# =============================================================================
# PERSONAL CONFIGURATION (Optional)
# =============================================================================
# Personal settings live directly in podcast/config.yaml. These env vars are
# only needed if you want to override config.yaml without editing it
# (e.g. to keep values out of a public fork).

# VIBECAST_LOCATION_NAME=New York, NY
# VIBECAST_LOCATION_LAT=40.7128
# VIBECAST_LOCATION_LON=-74.0060
# VIBECAST_TIMEZONE=America/New_York
# VIBECAST_SITE_URL=https://yourusername.github.io/vibecast/
# VIBECAST_FEED_URL=https://yourusername.github.io/vibecast/feed.xml
# VIBECAST_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# VIBECAST_ARTWORK_URL=https://yourusername.github.io/vibecast/artwork.png
# VIBECAST_AUTHOR=Your Name
# VIBECAST_AUTHOR_URL=https://yoursite.com
# VIBECAST_OWNER_EMAIL=you@example.com

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env to git (it's in .gitignore)
# - For GitHub Actions, set these as repository secrets instead
# - Personal settings here override podcast/config.yaml defaults
